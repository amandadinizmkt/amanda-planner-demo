# ============================================================
#  Amanda Planner — variáveis de ambiente
#  Copie este arquivo para .env.local e preencha os valores.
#  (.env.local é ignorado pelo git — nunca comite suas chaves.)
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# ── Anthropic (Coach IA) ────────────────────────────────────
# Chave secreta do Claude — usada SÓ no servidor (app/api/coach).
# Pegue em https://console.anthropic.com/settings/keys
# Nunca exponha no navegador nem comite essa chave.
ANTHROPIC_API_KEY=sk-ant-...
